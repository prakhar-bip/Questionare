# Database Connection (PostgreSQL / Supabase)
SQLALCHEMY_DATABASE_URI=postgresql://user:password@host:5432/dbname

# Environment mode ('development' uses Nvidia; 'production' uses Vertex AI Gemini 3.1 Pro)
ENVIRONMENT=development

# Google Cloud Vertex AI Configuration (Used in Production)
USE_VERTEX_AI=true
GCP_PROJECT_ID=project-e3e4dcb5-593d-4e61-9a8
GCP_LOCATION=us-central1
GCP_MODEL=gemini-3.1-pro

# Nvidia NIM AI API (Fallback)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
